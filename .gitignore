# Environment Variables (Keep sensitive secrets off GitHub)
.env
.env*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
*/*/*/node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
*/dist/
*/*/dist/
build/
*/build/
*/*/build/
out/
.next/
*/.next/
*/*/.next/

# User Uploads (Keep uploaded images local)
uploads/*
!uploads/.gitkeep
*/uploads/*
!*/uploads/.gitkeep
*/*/uploads/*
!*/*/uploads/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Cache
.cache/
.temp/
.tmp/
